# Django
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_NAME=fabrything
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# COD anti-spam throttles
THROTTLE_ORDER_CREATE=10/hour
THROTTLE_AUTH=20/hour
# Public analytics beacon (pageviews fire it on every load — keep generous)
THROTTLE_ANALYTICS=120/minute

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Object storage (optional — unset keys keep the DB-blob fallback).
# AWS S3: fill the four below. Cloudflare R2 (recommended, zero egress):
# keep the key vars, set REGION to "auto", and uncomment the last two.
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_ACESS_KEY_SECRET=your-access-key-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_S3_PUBLIC_BASE_URL=https://media.fabrything.com

# Optional signed journal bridge; leave automatic publication disabled until reviewed.
ECHOLINK_BLOG_SECRET=
ECHOLINK_BLOG_WORKSPACE_ID=
ECHOLINK_BLOG_PAGE_ID=
ECHOLINK_BLOG_AUTO_PUBLISH=false
