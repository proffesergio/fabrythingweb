# Backend API URL
REACT_APP_API_URL=http://localhost:8000/api/

# ── Google Analytics / Search Console / Ads ──────────────────────────
# Production values live in Vercel (Project > Settings > Environment
# Variables), NOT in this file — this file documents the contract.
# Local dev keeps them empty so no dev traffic pollutes real properties
# (utils/analytics.js + index.html both skip localhost anyway).
#
# GA4 Measurement ID (Admin > Data Streams). Current: G-S32TZJZCLV.
# The gtag snippet falls back to that ID when this is unset.
REACT_APP_GA4_MEASUREMENT_ID=
# Google Tag Manager container (tagmanager.google.com > new container).
# Empty = GTM block no-ops; set to GTM-XXXXXXX to activate.
REACT_APP_GTM_ID=
# Search Console > Add property > HTML tag method > copy the token only.
REACT_APP_GOOGLE_SITE_VERIFICATION=
# AdSense > Sites > Add site > copy the pub ID (ca-pub-XXXXXXXXXXXXXXXX).
REACT_APP_ADSENSE_CLIENT=
