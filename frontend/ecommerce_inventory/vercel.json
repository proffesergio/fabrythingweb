{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "CI=false react-scripts build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://fabrythingapi.vercel.app/api/store/sitemap.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "https://fabrythingapi.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
