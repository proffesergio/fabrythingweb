{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "CI=false react-scripts build",
  // NOTE (2026-09-30): an Ezoic ads.txt 301 lived here briefly and was
  // reverted BEFORE any deploy. Ezoic's manager doesn't know fabrything.com
  // yet (account not integrated — dashboard only offers nameserver verify),
  // so redirecting would have replaced our working AdSense ads.txt with an
  // empty/unknown manager page and broken AdSense authorization mid-review.
  // Revisit only AFTER Ezoic integration is detected, and only with the
  // AdSense line confirmed inside their manager first.
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
