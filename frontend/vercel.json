{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "CI=false react-scripts build",
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "nobleseek.fabrything.com"
        }
      ],
      "destination": "/nobleseek",
      "permanent": false
    },
    {
      "source": "/nobleseek/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.fabrything.com"
        }
      ],
      "destination": "https://nobleseek.fabrything.com/nobleseek/:path*",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "has": [
        {
          "type": "host",
          "value": "nobleseek.fabrything.com"
        }
      ],
      "destination": "https://www.fabrything.com/blog/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "nobleseek.fabrything.com"
        }
      ],
      "destination": "/nobleseek-robots.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "https://fabrythingapi.vercel.app/api/store/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "nobleseek.fabrything.com"
        }
      ],
      "destination": "https://fabrythingapi.vercel.app/api/store/nobleseek/sitemap.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://fabrythingapi.vercel.app/api/store/sitemap.xml"
    },
    {
      "source": "/api/:path*/",
      "destination": "https://fabrythingapi.vercel.app/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://fabrythingapi.vercel.app/api/:path*"
    },
    {
      "source": "/blog",
      "destination": "https://fabrythingapi.vercel.app/api/store/journal/archive/"
    },
    {
      "source": "/blog/topic/:topic",
      "destination": "https://fabrythingapi.vercel.app/api/store/journal/archive/:topic/"
    },
    {
      "source": "/blog/:slug",
      "destination": "https://fabrythingapi.vercel.app/api/store/journal/document/:slug/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
